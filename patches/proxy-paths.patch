+func TestLoadConfigRejectsBadPathPolicy(t *testing.T) {
+	cases := map[string]string{
+		"no paths key":         `{"a.example": {"methods": "*"}}`,
+		"empty paths":          `{"a.example": {"paths": []}}`,
+		"relative path":        `{"a.example": {"paths": ["a/b"]}}`,
+		"star not last":        `{"a.example": {"paths": ["/a/*/b"]}}`,
+		"star inside segment":  `{"a.example": {"paths": ["/a/b*"]}}`,
+		"double star":          `{"a.example": {"paths": ["/a/**"]}}`,
+		"empty segment":        `{"a.example": {"paths": ["/a//b"]}}`,
+		"trailing slash":       `{"a.example": {"paths": ["/a/"]}}`,
+		"dot-dot segment":      `{"a.example": {"paths": ["/a/../b"]}}`,
+		"percent escape":       `{"a.example": {"paths": ["/a%2Fb"]}}`,
+		"semicolon":            `{"a.example": {"paths": ["/a;b"]}}`,
+		"space":                `{"a.example": {"paths": ["/a b"]}}`,
+		"unknown key":          `{"a.example": {"paths": ["/a"], "path": ["/b"]}}`,
+		"bad methods string":   `{"a.example": {"methods": "GET", "paths": ["/a"]}}`,
+		"paths not a list":     `{"a.example": {"paths": "/a"}}`,
+	}
+	for name, raw := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := loadTestConfig(t, raw); err == nil {
+				t.Errorf("loadConfig(%s) succeeded, want an error", raw)
+			}
+		})
+	}
+}
