+func TestPathPolicyWebSocket(t *testing.T) {
+	cfg, err := loadTestConfig(t, `{"buzz.example": {"paths": ["/ws/*"]}}`)
+	if err != nil {
+		t.Fatalf("loadConfig: %v", err)
+	}
+	for target, want := range map[string]int{"/ws/fable": 0, "/other": http.StatusForbidden} {
+		raw := "GET " + target + " HTTP/1.1\r\nHost: buzz.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n"
+		status, reason := applyFilters(readRequest(t, raw), "buzz.example", "443", cfg)
+		if status != want {
+			t.Errorf("WebSocket upgrade to %s = (%d, %q), want status %d", target, status, reason, want)
+		}
+	}
+}
