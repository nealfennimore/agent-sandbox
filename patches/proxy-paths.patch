+// parsePolicy reads one allowlist value: "*", a method list, or an object
+// with "methods" and "paths".
+func parsePolicy(domain string, val json.RawMessage) (DomainPolicy, error) {
+	trimmed := bytes.TrimSpace(val)
+	if len(trimmed) > 0 && trimmed[0] == '{' {
+		return parsePathPolicy(domain, trimmed)
+	}
+	return parseMethods(domain, val)
+}
+
+func parseMethods(domain string, val json.RawMessage) (DomainPolicy, error) {
+	var star string
+	if err := json.Unmarshal(val, &star); err == nil {
+		if star == "*" {
+			return DomainPolicy{AllowAll: true}, nil
+		}
+		return DomainPolicy{}, fmt.Errorf("invalid policy for %q: string must be \"*\", got %q", domain, star)
+	}
+	var methods []string
+	if err := json.Unmarshal(val, &methods); err != nil {
+		return DomainPolicy{}, fmt.Errorf("invalid policy for %q: expected \"*\", [\"METHOD\", ...] or {\"methods\": ..., \"paths\": [...]}: %w", domain, err)
+	}
+	m := make(map[string]bool)
+	for _, method := range methods {
+		upper := strings.ToUpper(method)
+		if !knownHTTPMethods[upper] {
+			fmt.Fprintf(os.Stderr, "WARNING: unrecognized HTTP method %q for domain %q\n", method, domain)
+		}
+		m[upper] = true
+	}
+	return DomainPolicy{Methods: m}, nil
+}
+
+// parsePathPolicy reads the object form {"methods": "*" | [...], "paths":
+// [...]}. A missing "methods" means "*". An unknown key, an empty "paths"
+// list, or a bad pattern fails the load, so a typo cannot widen the policy.
+func parsePathPolicy(domain string, val []byte) (DomainPolicy, error) {
+	var obj struct {
+		Methods json.RawMessage `json:"methods"`
+		Paths   []string        `json:"paths"`
+	}
+	dec := json.NewDecoder(bytes.NewReader(val))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&obj); err != nil {
+		return DomainPolicy{}, fmt.Errorf("invalid policy for %q: %w", domain, err)
+	}
+	policy := DomainPolicy{AllowAll: true}
+	if obj.Methods != nil {
+		var err error
+		policy, err = parseMethods(domain, obj.Methods)
+		if err != nil {
+			return DomainPolicy{}, err
+		}
+	}
+	if len(obj.Paths) == 0 {
+		return DomainPolicy{}, fmt.Errorf("invalid policy for %q: \"paths\" must list at least one path", domain)
+	}
+	for _, p := range obj.Paths {
+		pat, err := parsePathPattern(p)
+		if err != nil {
+			return DomainPolicy{}, fmt.Errorf("invalid path %q for %q: %w", p, domain, err)
+		}
+		policy.Paths = append(policy.Paths, pat)
+	}
+	return policy, nil
+}
+
+// parsePathPattern reads one "paths" entry. "*" is allowed only as the whole
+// last segment. Each literal segment must pass checkSegment, the same check
+// that a request path must pass.
+func parsePathPattern(p string) (pathPattern, error) {
+	if !strings.HasPrefix(p, "/") {
+		return pathPattern{}, errors.New("a path must start with \"/\"")
+	}
+	if p == "/" {
+		return pathPattern{}, nil
+	}
+	segments := strings.Split(p[1:], "/")
+	var pat pathPattern
+	for i, seg := range segments {
+		if seg == "*" {
+			if i != len(segments)-1 {
+				return pathPattern{}, errors.New("\"*\" is allowed only as the last segment")
+			}
+			pat.wildcard = true
+			break
+		}
+		if strings.Contains(seg, "*") {
+			return pathPattern{}, errors.New("\"*\" must be a whole segment")
+		}
+		if err := checkSegment(seg); err != nil {
+			return pathPattern{}, err
+		}
+		pat.segments = append(pat.segments, seg)
+	}
+	return pat, nil
+}
+
+// isPathChar reports whether c is an RFC 3986 pchar other than "%" and ";".
+// "%" is refused so that the bytes the proxy matches are the bytes the origin
+// decodes. ";" is refused because some servers (Tomcat, Jetty) strip path
+// parameters, so "/a/..;/b" reaches them as "/b".
+func isPathChar(c byte) bool {
+	switch {
+	case 'a' <= c && c <= 'z', 'A' <= c && c <= 'Z', '0' <= c && c <= '9':
+		return true
+	}
+	return strings.IndexByte("-._~!$&'()*+,=:@", c) >= 0
+}
+
+func isHex(c byte) bool {
+	return ('0' <= c && c <= '9') || ('a' <= c && c <= 'f') || ('A' <= c && c <= 'F')
+}
+
+// checkSegment refuses an empty segment ("//" or a trailing "/"), a dot
+// segment, and a character outside isPathChar.
+func checkSegment(seg string) error {
+	if seg == "" {
+		return errors.New("empty path segment")
+	}
+	if seg == "." || seg == ".." {
+		return errors.New("dot segment")
+	}
+	for i := 0; i < len(seg); i++ {
+		if !isPathChar(seg[i]) {
+			return fmt.Errorf("character %q is not allowed", seg[i])
+		}
+	}
+	return nil
+}
+
+// matches compares path segments with the pattern. A wildcard pattern needs
+// at least one segment after its literal segments.
+func (p pathPattern) matches(segments []string) bool {
+	if p.wildcard {
+		if len(segments) <= len(p.segments) {
+			return false
+		}
+	} else if len(segments) != len(p.segments) {
+		return false
+	}
+	for i, seg := range p.segments {
+		if segments[i] != seg {
+			return false
+		}
+	}
+	return true
+}
+
+// pathAllowed judges the request URL that net/url parsed. EscapedPath gives
+// the path as the client sent it (RawPath, when net/url kept it). The check
+// requires that form to have no "%" and to equal the decoded Path, so a match
+// on Path is a match on the bytes that went over the wire.
+func pathAllowed(u *url.URL, patterns []pathPattern) bool {
+	if u.Opaque != "" {
+		return false
+	}
+	if escaped := u.EscapedPath(); escaped != u.Path || strings.Contains(escaped, "%") {
+		return false
+	}
+	path := u.Path
+	if path == "" {
+		path = "/"
+	}
+	if !strings.HasPrefix(path, "/") {
+		return false
+	}
+	var segments []string
+	if path != "/" {
+		segments = strings.Split(path[1:], "/")
+	}
+	for _, seg := range segments {
+		if checkSegment(seg) != nil {
+			return false
+		}
+	}
+	for _, pat := range patterns {
+		if pat.matches(segments) {
+			return true
+		}
+	}
+	return false
+}
+
+// queryAllowed accepts an empty query, or a query of RFC 3986 query
+// characters (pchar, "/" and "?", with ";" refused as in isPathChar) whose
+// escapes are well formed and which url.ParseQuery reads without error.
+func queryAllowed(u *url.URL) bool {
+	q := u.RawQuery
+	if q == "" {
+		return true
+	}
+	for i := 0; i < len(q); i++ {
+		c := q[i]
+		if c == '%' {
+			if i+2 >= len(q) || !isHex(q[i+1]) || !isHex(q[i+2]) {
+				return false
+			}
+			i += 2
+			continue
+		}
+		if !isPathChar(c) && c != '/' && c != '?' {
+			return false
+		}
+	}
+	_, err := url.ParseQuery(q)
+	return err == nil
+}
