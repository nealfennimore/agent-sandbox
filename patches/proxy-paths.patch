+// loadTestConfig writes raw to an allowlist file and loads it, so the tests
+// cover the JSON form an operator writes as well as the matching.
+func loadTestConfig(t *testing.T, raw string) (Config, error) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "allowlist.json")
+	if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+		t.Fatalf("write config: %v", err)
+	}
+	return loadConfig(path)
+}
+
+func TestPathPolicy(t *testing.T) {
+	cfg, err := loadTestConfig(t, `{
+		"buzz.example": {"paths": ["/buzz/agent/mcp/fable", "/buzz/agent/mcp/fable/*"]},
+		"get.example": {"methods": ["GET"], "paths": ["/read/*"]},
+		"root.example": {"paths": ["/"]},
+		"open.example": "*",
+		"list.example": ["GET"]
+	}`)
+	if err != nil {
+		t.Fatalf("loadConfig: %v", err)
+	}
+	cases := []struct {
+		name   string
+		host   string
+		target string
+		method string
+		status int
+	}{
+		{"exact path", "buzz.example", "/buzz/agent/mcp/fable", "", 0},
+		{"wildcard depth 1", "buzz.example", "/buzz/agent/mcp/fable/sse", "", 0},
+		{"wildcard depth 3", "buzz.example", "/buzz/agent/mcp/fable/a/b/c", "", 0},
+		{"wildcard allows POST by default", "buzz.example", "/buzz/agent/mcp/fable/sse", "POST", 0},
+		{"wildcard segment with pchar", "buzz.example", "/buzz/agent/mcp/fable/a-b_c.d~e!$&'()*+,=:@", "", 0},
+		{"clean query", "buzz.example", "/buzz/agent/mcp/fable/sse?session=a1&x=%20y/z?", "", 0},
+		{"sibling agent", "buzz.example", "/buzz/agent/mcp/claude/sse", "", http.StatusForbidden},
+		{"parent path", "buzz.example", "/buzz/agent/mcp", "", http.StatusForbidden},
+		{"root", "buzz.example", "/", "", http.StatusForbidden},
+		{"prefix without separator", "buzz.example", "/buzz/agent/mcp/fablex", "", http.StatusForbidden},
+		{"trailing slash", "buzz.example", "/buzz/agent/mcp/fable/", "", http.StatusForbidden},
+		{"double slash", "buzz.example", "/buzz/agent/mcp/fable//x", "", http.StatusForbidden},
+		{"dot-dot", "buzz.example", "/buzz/agent/mcp/fable/../claude", "", http.StatusForbidden},
+		{"dot", "buzz.example", "/buzz/agent/mcp/fable/./x", "", http.StatusForbidden},
+		{"escaped dot-dot", "buzz.example", "/buzz/agent/mcp/fable/%2e%2e/claude", "", http.StatusForbidden},
+		{"escaped slash", "buzz.example", "/buzz/agent/mcp/fable/a%2Fb", "", http.StatusForbidden},
+		{"escaped literal", "buzz.example", "/buzz/agent/mcp/%66able/x", "", http.StatusForbidden},
+		{"escaped space", "buzz.example", "/buzz/agent/mcp/fable/a%20b", "", http.StatusForbidden},
+		{"backslash", "buzz.example", "/buzz/agent/mcp/fable/a\\b", "", http.StatusForbidden},
+		{"semicolon", "buzz.example", "/buzz/agent/mcp/fable/..;/claude", "", http.StatusForbidden},
+		{"case differs", "buzz.example", "/buzz/agent/mcp/Fable/x", "", http.StatusForbidden},
+		{"bad query escape", "buzz.example", "/buzz/agent/mcp/fable/sse?x=%zz", "", http.StatusForbidden},
+		{"truncated query escape", "buzz.example", "/buzz/agent/mcp/fable/sse?x=%2", "", http.StatusForbidden},
+		{"query semicolon", "buzz.example", "/buzz/agent/mcp/fable/sse?a=1;b=2", "", http.StatusForbidden},
+		{"query backslash", "buzz.example", "/buzz/agent/mcp/fable/sse?a=\\", "", http.StatusForbidden},
+		{"absolute form allowed", "buzz.example", "http://buzz.example/buzz/agent/mcp/fable/x", "", 0},
+		{"absolute form blocked", "buzz.example", "http://buzz.example/buzz/agent/mcp/claude/x", "", http.StatusForbidden},
+		{"asterisk form", "buzz.example", "*", "OPTIONS", http.StatusForbidden},
+		{"method list still applies", "get.example", "/read/x", "POST", http.StatusForbidden},
+		{"method list path", "get.example", "/read/x", "GET", 0},
+		{"wildcard needs a segment", "get.example", "/read", "GET", http.StatusForbidden},
+		{"root pattern", "root.example", "/", "", 0},
+		{"root pattern only", "root.example", "/x", "", http.StatusForbidden},
+		{"star entry has no path filter", "open.example", "/any/../thing%2F", "", 0},
+		{"method entry has no path filter", "list.example", "/any//thing", "GET", 0},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			method := c.method
+			if method == "" {
+				method = "GET"
+			}
+			raw := fmt.Sprintf("%s %s HTTP/1.1\r\nHost: %s\r\n\r\n", method, c.target, c.host)
+			if method == "POST" {
+				raw = fmt.Sprintf("%s %s HTTP/1.1\r\nHost: %s\r\nContent-Length: 0\r\n\r\n", method, c.target, c.host)
+			}
+			req := readRequest(t, raw)
+			status, reason := applyFilters(req, c.host, "443", cfg)
+			if status != c.status {
+				t.Errorf("applyFilters(%s %s) = (%d, %q), want status %d", method, c.target, status, reason, c.status)
+			}
+		})
+	}
+}
